{
  "name": "counthouse-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "config": {
    "contractRepo": "Mfigueira98/counthouse-api",
    "contractCommit": "912a17d61afff98dfa2467c4eaea405ceb1d5e20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "contract:types": "openapi-typescript contract/openapi.yaml --default-non-nullable false --root-types --root-types-no-schema-prefix --output src/server/api/schema.d.ts",
    "contract:check": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "@nicolassancho/storybook-core": "^4.6.0",
    "msw": "^3.0.3",
    "next": "16.4.3",
    "openapi-fetch": "^0.17.0",
    "openapi-msw": "^2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-boundaries": "^7.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
